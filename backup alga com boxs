\begin{proposition}
  A composta de aplicações lineares é uma aplicação linear.
\end{proposition}
\begin{proof}
  Sejam $f:E\rightarrow F$ e $g:F\rightarrow G$ aplicações lineares.

  $\forall u,v \in E$, tem-se  $g\circ f(u+v)=g(f(u+v))=g(f(u)+f(v))=g(f(u))+g(f(v))=g\circ f(u)+g\circ f(v))$
 
  $\forall \alpha \in \K, u\in E$, tem-se $g\circ f(\alpha u)=g(f(\alpha u))=g(\alpha f(u))=\alpha g(f(u))=\alpha g\circ f(u)$
\end{proof}

\begin{proposition}
  Sejam $E, F$ espaços vetoriais sobre $\K $; o conjunto $L(E,F)={\text{funções de} E em F}$ é um espaço vetorial. (É um subespaço do espaço $F(E,F)={\text{funções de}E \text{em}F}$; neste espaço as operações são definidas da seguinte maneira:
  \begin{itemize}
    \item $f+g$ é a função definida por $(f+g)(u)=f(u)+g(u)$
    \item $\alpha f$ é a função definida por $(\alpha f)(u)=\alpha (f(u))$
  \end{itemize})

\end{proposition}

\begin{proof}
  Uma aplicação linear contém todas as propriedades de um espaço vetorial, ver Definição 1.1.
  Uns exemplos são:
  \begin{itemize}
    \item $f(u)+f(v)=f(u+v)$, que por definição pertence a $L(E,F)$
    \item $\alpha f(u)=f(\alpha u)$, que por definição pertence a $L(E,F)$
  \end{itemize}

\end{proof}


\begin{proposition}
  Sejam $E,F$ espaços vetoriais sobre $\K$ ; se $(e_1,\ldots,e_{n}$ é uma base de $E$ e $w_1,\ldots,w_{n}$ são elementos quaisque de $F$, existe uma e só uma aplicação linear $f:E\longrightarrow F:f(e_1)=w_1,\ldots,f(e{n})=w_{n}$, i.e., uma aplicação linear fica completamente determinada pelas suas imagens dos elementos de uma base, e essas imagens podem ser escolhidas arbitrariamente).

\end{proposition}
\begin{proof}
  Unicidade:

  Se $u\in E$, então $\exists a_1,\ldots,a_{n}:u=a_1e_1+\ldots+a_{n}e_{n}$. A partir disto temos que $f(u)=f(a_1e_1+\ldots+a_{n}e_{n})=f(a_1e_1)+\ldots+f(a_{n}e{n})=a_1f(e_1)+\ldots+a_{n}f(e_{n})=a_1w_1+\ldots+a_{n}e_{n}$, logo se $f$ existir, $f(u)$ está completamente determinado para cada $u$.

  Existência:

  Para cada $u \in E$, seja $f(u)=a_1w_1+\ldots+a_{n}w_{n}$, onde $a_1,\ldots,a_{n}$ são os únicos elementos de $\K$ tais que $u=a_1e_1,\ldots,a_{n}e_{n}$, logo, $f$ fica bem definida. Basta agora provar que $f$ é linear. Sejam $u,v\in E$ tais que $u=a_1e_1,\ldots,a_{n}e_{n}$ e $b_1e_1,\ldots,b_{n}e_{n}$.
\end{proof}



